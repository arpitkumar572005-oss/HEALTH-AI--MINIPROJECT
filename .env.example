# Application Settings
PROJECT_NAME=HealthAI
ENVIRONMENT=development

# Database Configuration
# Local SQLite default (runs with zero dependencies):
DATABASE_URL=sqlite:///./healthai.db
# Or PostgreSQL for production/Docker:
# DATABASE_URL=postgresql://healthai_user:healthai_secure_password@localhost:5432/healthai_db

# Security
JWT_SECRET=healthai-secure-jwt-token-signing-key-replace-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]
